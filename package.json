{
  "name": "record-screen",
  "private": true,
  "version": "0.1.8",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm exec tauri -- dev --config src-tauri/tauri.conf.json",
    "dev:web": "npm run dev --workspace @record-screen/desktop",
    "build": "npm exec tauri -- build --config src-tauri/tauri.conf.json",
    "build:web": "npm run build --workspace @record-screen/desktop",
    "lint": "npm run lint --workspace @record-screen/desktop"
  }
}
