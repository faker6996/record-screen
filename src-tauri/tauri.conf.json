{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Record Screen",
  "version": "0.1.35",
  "identifier": "com.tranvanbach.recordscreen",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @record-screen/desktop",
    "beforeBuildCommand": "npm run build --workspace @record-screen/desktop",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Record Screen",
        "width": 1280,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Tran Van Bach",
    "homepage": "https://github.com/faker6996/record-screen",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "copyright": "Copyright (c) 2026 Tran Van Bach",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Video",
    "shortDescription": "Desktop screen recorder with launcher, HUD, and shortcut-driven capture.",
    "longDescription": "Record Screen is a Tauri desktop recorder for macOS, Linux, and Windows with global shortcuts, a launcher and HUD, and native capture flows for full desktop, display, and window targets where supported.",
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-tools",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-pipewire",
          "xdg-utils"
        ],
        "recommends": [
          "xdg-utils"
        ],
        "section": "video",
        "priority": "optional"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  }
}
